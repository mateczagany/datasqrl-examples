{
  "version": "1",
  "enabled-engines": ["vertx", "iceberg", "duckdb", "flink"],
  "script": {
    "main": "aggregation-query-test.sqrl"
  },
  "engines": {
    "flink": {
      "config": {
        "execution.runtime-mode": "STREAMING",
        "security.delegation.tokens.enabled": false,
        "state.backend.type": "rocksdb",
        "table.exec.source.idle-timeout": "10 s",
        "table.exec.async-lookup.buffer-capacity": 20,
        "table.exec.async-lookup.timeout": "40 min",
        "table.exec.async-lookup.output-mode": "ALLOW_UNORDERED",
        "table.exec.sink.upsert-materialize": "NONE",
        "taskmanager.memory.task.off-heap.size": "4G"
      },
      "deployment": {
        "jobmanager-size": "small",
        "taskmanager-size": "large.mem-headroom",
        "taskmanager-count": 2
      }
    },
    "duckdb": {
      "url": "jdbc:duckdb:"
    }
  },
  "connectors": {
    "iceberg": {
      "warehouse": "s3a://sqrl-examples-data-bucket/datasqrl-examples/iceberg-canary",
      "catalog-type": "hadoop",
      "catalog-name": "mycatalog"
    }
  }
}
